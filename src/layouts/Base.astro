---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Геймдизайнер. Unity, Godot, C#, инструменты и пайплайны." } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%3E%3Ctext%20y%3D%22.9em%22%20font-size%3D%2290%22%3E%F0%9F%8E%AE%3C%2Ftext%3E%3C%2Fsvg%3E" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <dialog id="lightbox">
      <button id="lightbox-close" type="button" aria-label="Закрыть">✕</button>
      <div id="lightbox-stage"></div>
      <p id="lightbox-caption"></p>
    </dialog>
  </body>
</html>

<script>
  // Lives here, not in Media.astro: the drawer on the index page injects the same
  // markup, so the handler has to be present on every page.
  // maxresdefault.jpg is missing for many videos; fall back to the always-present size.
  document.addEventListener(
    "error",
    (event) => {
      const img = event.target as HTMLImageElement;
      if (img.tagName !== "IMG" || !img.dataset.fallback) return;
      img.src = img.dataset.fallback;
      delete img.dataset.fallback;
    },
    true
  );

  const lightbox = document.getElementById("lightbox") as HTMLDialogElement;
  const stage = document.getElementById("lightbox-stage")!;
  const caption = document.getElementById("lightbox-caption")!;

  document.addEventListener("click", (event) => {
    const thumb = (event.target as HTMLElement).closest<HTMLElement>(".media-thumb");
    if (thumb) {
      stage.replaceChildren(buildFullSize(thumb.dataset));
      caption.textContent =
        thumb.closest(".media-item")?.querySelector("figcaption")?.textContent ?? "";
      lightbox.showModal();
      return;
    }

    // Clicking the backdrop — anywhere outside the dialog's own content — closes it.
    if (lightbox.open && (event.target === lightbox || (event.target as HTMLElement).id === "lightbox-close")) {
      lightbox.close();
    }
  });

  function buildFullSize({ type, src, id }: DOMStringMap) {
    if (type === "youtube") {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      return iframe;
    }

    if (type === "video") {
      const video = document.createElement("video");
      video.src = src!;
      video.controls = true;
      video.autoplay = true;
      video.loop = true;
      video.playsInline = true;
      return video;
    }

    const img = document.createElement("img");
    img.src = src!;
    return img;
  }

  lightbox.addEventListener("close", () => stage.replaceChildren());
</script>

<style is:global>
  :root {
    --bg: #0d0e12;
    --bg-elevated: #15171d;
    --border: #262932;
    --text: #e7e7ea;
    --text-dim: #9a9ba5;
    --accent: #7dd3a8;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Arial, sans-serif;
    line-height: 1.6;
  }

  a { color: var(--accent); }

  img { max-width: 100%; display: block; }

  .wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  h1, h2, h3 { line-height: 1.25; letter-spacing: -0.01em; }

  code {
    background: var(--bg-elevated);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  /* --- Project body: rendered both on its own page and inside the index drawer --- */

  .project-head { margin-bottom: 2.5rem; }
  .project-head h1 { margin: 0 0 0.25rem; font-size: 1.8rem; }
  .project-head .period { color: var(--text-dim); margin: 0; }

  .content h1 { font-size: 1.4rem; margin-top: 2.5rem; }
  .content h2 { font-size: 1.2rem; margin-top: 2rem; }
  .content img {
    border-radius: 10px;
    border: 1px solid var(--border);
    margin: 1.5rem 0;
    max-height: 460px;
    width: auto;
    object-fit: contain;
  }
  .content ul { padding-left: 1.3em; }
  .content li { margin: 0.35em 0; }
  .content hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .media-section h2 { font-size: 1.2rem; margin-top: 2.5rem; }

  .media {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .media-item { margin: 0; }

  .media-thumb {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #000;
    cursor: zoom-in;
    transition: border-color 0.15s ease;
  }
  .media-thumb:hover { border-color: var(--accent); }

  .media-thumb img,
  .media-thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }
  .media-thumb:hover img,
  .media-thumb:hover video { transform: scale(1.03); }

  .media-badge {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
    pointer-events: none;
  }

  .media figcaption {
    margin-top: 0.6rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .steam-embeds {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .steam-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-elevated);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .steam-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .steam-card img {
    width: 230px;
    flex-shrink: 0;
    border-radius: 8px;
  }

  .steam-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .steam-title { font-weight: 600; }
  .steam-meta { color: var(--text-dim); font-size: 0.85rem; }

  @media (max-width: 560px) {
    .steam-card { flex-direction: column; align-items: flex-start; }
    .steam-card img { width: 100%; }
  }

  #lightbox {
    width: min(1200px, 92vw);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: none;
    border-radius: 12px;
    background: transparent;
    overflow: visible;
  }
  #lightbox::backdrop { background: rgba(0, 0, 0, 0.85); }

  #lightbox-stage img,
  #lightbox-stage video {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 92vh;
    margin-inline: auto;
    border-radius: 12px;
  }
  #lightbox-stage iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 12px;
  }

  #lightbox-caption {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  #lightbox-caption:empty { display: none; }

  #lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elevated);
    color: var(--text);
    cursor: pointer;
  }
  #lightbox-close:hover { border-color: var(--accent); color: var(--accent); }
</style>
