---
import "@fontsource-variable/inter";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Геймдизайнер. Unity, Godot, C#, инструменты и пайплайны.",
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? "/og.png", Astro.site);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%3E%3Ctext%20y%3D%22.9em%22%20font-size%3D%2290%22%3E%F0%9F%8E%AE%3C%2Ftext%3E%3C%2Fsvg%3E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Варганов Арсений — портфолио" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />

    <dialog id="lightbox">
      <button id="lightbox-close" type="button" aria-label="Закрыть">✕</button>
      <div id="lightbox-stage"></div>
      <p id="lightbox-caption"></p>
    </dialog>
  </body>
</html>

<script>
  // Lives here, not in a component: the drawer on the index page injects the same
  // markup, so the handlers have to be present on every page.

  // maxresdefault.jpg is missing for many videos; fall back to the always-present size.
  document.addEventListener(
    "error",
    (event) => {
      const img = event.target as HTMLImageElement;
      if (img.tagName !== "IMG" || !img.dataset.fallback) return;
      img.src = img.dataset.fallback;
      delete img.dataset.fallback;
    },
    true
  );

  const lightbox = document.getElementById("lightbox") as HTMLDialogElement;
  const stage = document.getElementById("lightbox-stage")!;
  const caption = document.getElementById("lightbox-caption")!;

  document.addEventListener("click", (event) => {
    const thumb = (event.target as HTMLElement).closest<HTMLElement>(".media-thumb");
    if (thumb) {
      stage.replaceChildren(buildFullSize(thumb));
      caption.textContent =
        thumb.closest(".media-item")?.querySelector("figcaption")?.textContent ?? "";
      lightbox.showModal();
      return;
    }

    // Clicking the backdrop — anywhere outside the dialog's own content — closes it.
    if (lightbox.open && (event.target === lightbox || (event.target as HTMLElement).id === "lightbox-close")) {
      lightbox.close();
    }
  });

  function buildFullSize(thumb: HTMLElement) {
    const { type, src, id } = thumb.dataset;

    if (type === "youtube") {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      return iframe;
    }

    if (type === "video") {
      const video = document.createElement("video");
      video.src = src!;
      video.controls = true;
      video.autoplay = true;
      video.loop = true;
      video.playsInline = true;
      return video;
    }

    const img = document.createElement("img");
    img.src = src!;
    img.alt = thumb.querySelector("img")?.alt ?? "";
    return img;
  }

  lightbox.addEventListener("close", () => stage.replaceChildren());

  // Video tiles stay paused until seen, so a page of clips costs nothing up front.
  const motionOk = !matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (motionOk && "IntersectionObserver" in window) {
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        }
      },
      { rootMargin: "200px" }
    );

    const observe = () =>
      document
        .querySelectorAll<HTMLVideoElement>(".media-thumb video:not([data-watched])")
        .forEach((video) => {
          video.dataset.watched = "";
          watcher.observe(video);
        });

    observe();
    // The drawer injects more tiles after load.
    document.addEventListener("drawer:content", observe);
  }
</script>

<style is:global>
  :root {
    --bg: #0d0e12;
    --bg-elevated: #191c24;
    --bg-sunken: #0a0b0e;
    --border: #2f333d;
    --border-strong: #5c606d;
    --text: #e7e7ea;
    --text-dim: #9a9ba5;
    --accent: #7dd3a8;

    /* 1.25 type scale */
    --s1: 1.25rem;
    --s2: 1.5625rem;
    --s3: 1.953rem;
    --s4: 2.441rem;

    /* spacing rhythm */
    --sp-1: 0.5rem;
    --sp-2: 1rem;
    --sp-3: 1.5rem;
    --sp-4: 2rem;
    --sp-6: 3rem;
    --sp-8: 4rem;

    color-scheme: dark;
  }

  * { box-sizing: border-box; }

  html {
    /* Keeps the page from shifting when the drawer locks scrolling. */
    scrollbar-gutter: stable;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
  }

  body {
    font-family: "Inter Variable", "Segoe UI", system-ui, sans-serif;
    line-height: 1.6;
  }

  button { font: inherit; }

  a { color: var(--accent); }

  img { max-width: 100%; display: block; }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .wrap {
    /* Wide enough for three cards, narrow enough that a paragraph does not sit
       in the left third of an empty page. */
    max-width: 920px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3) var(--sp-8);
  }

  h1, h2, h3 {
    line-height: 1.2;
    font-weight: 600;
  }
  h1, h2 { letter-spacing: -0.015em; }

  code {
    background: var(--bg-elevated);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  /* --- Project body: rendered both on its own page and inside the index drawer --- */

  .project-head { margin-bottom: var(--sp-4); }
  .project-head h1 { margin: 0 0 var(--sp-1); font-size: var(--s3); }
  .project-head .period { color: var(--text-dim); margin: 0; }

  /* Prose keeps a readable measure; galleries use the full column. */
  .content > p,
  .content > ul,
  .content > ol,
  .content > blockquote,
  .content > h2,
  .content > h3,
  .content > h4 {
    max-width: 68ch;
  }

  .content h2 { font-size: var(--s2); margin-top: var(--sp-6); }
  .content h3 { font-size: var(--s1); margin-top: var(--sp-4); }
  .content ul { padding-left: 1.3em; }
  .content li { margin: var(--sp-1) 0; }
  .content hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--sp-6) 0;
  }
  .content img {
    border-radius: 10px;
    border: 1px solid var(--border);
    margin: var(--sp-3) 0;
  }

  /* --- Media tiles --- */

  .media {
    display: grid;
    /* --cols comes from how many tiles the paragraph holds (remark-media). */
    grid-template-columns: repeat(var(--cols, 1), minmax(0, 1fr));
    gap: var(--sp-3);
    align-items: start;
    margin: var(--sp-3) 0;
  }

  /* Narrow screens drop the fixed count and fit what they can — a lone tile
     still takes the full width. */
  @media (max-width: 760px) {
    .media { grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  }
  @media (max-width: 480px) {
    .media { grid-template-columns: 1fr; }
  }

  .media-item { margin: 0; }

  .media-thumb {
    display: block;
    position: relative;
    width: 100%;
    /* One ratio for every tile type, so rows keep a straight bottom edge. */
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg-sunken);
    cursor: zoom-in;
    transition: border-color 0.15s ease;
  }
  .media-thumb:hover { border-color: var(--accent); }
  /* Screenshots keep their own shape: the tile hugs the image instead of
     framing it inside a letterboxed box. Tiles in a row stay top-aligned. */
  .media-thumb[data-type="image"] {
    aspect-ratio: auto;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  .media-thumb[data-type="image"] img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 70vh;
  }
  .media-item:has(> .media-thumb[data-type="image"]) figcaption { text-align: center; }
  .media-thumb[data-type="video"],
  .media-thumb[data-type="youtube"] { cursor: pointer; }

  .media-thumb img,
  .media-thumb video {
    display: block;
    /* The tile draws the frame; undo the margin and border .content img adds,
       which pushed the picture down inside the tile. */
    margin: 0;
    border: none;
    border-radius: 0;
    width: 100%;
    height: 100%;
    /* Screenshots are often square or portrait — never crop them. */
    object-fit: contain;
    transition: transform 0.25s ease;
  }
  .media-thumb[data-type="youtube"] img { object-fit: cover; }
  .media-thumb:hover img,
  .media-thumb:hover video { transform: scale(1.02); }

  .media-badge {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 1.25rem;
    pointer-events: none;
  }

  .media figcaption {
    margin-top: var(--sp-1);
    color: var(--text-dim);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* --- Steam --- */

  .steam-embeds {
    display: grid;
    gap: var(--sp-2);
    margin: var(--sp-3) 0;
  }

  /* A 50px bar, split down the middle: the store link on the left, the role
     centred in the other half. */
  .release {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: 50px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  /* A panel written without a role cell (remark-links) keeps the whole bar. */
  .release-solo { grid-template-columns: 1fr; }

  .steam-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: var(--sp-1) var(--sp-3);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .steam-link:hover { color: var(--accent); background: var(--bg-sunken); }
  .steam-mark { flex-shrink: 0; }

  .release-role {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: 0;
    padding: var(--sp-1) var(--sp-3);
    border-left: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  a.release-role {
    color: var(--text-dim);
    text-decoration: none;
  }
  a.release-role:hover { color: var(--accent); background: var(--bg-sunken); }

  @media (max-width: 620px) {
    .release { grid-template-columns: 1fr; }
    .release-role { border-left: none; border-top: 1px solid var(--border); }
  }

  /* --- Link chips (remark-links) --- */

  /* Links written as a bare URL: a slim pill instead of the raw address.
     A paragraph of nothing but such links becomes a wrapping row. */
  .link-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: var(--sp-3) 0;
  }

  .link-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    max-width: 100%;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-decoration: none;
    vertical-align: baseline;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .link-chip:hover { border-color: var(--accent); color: var(--accent); }
  .link-chip-host { color: var(--text-dim); white-space: nowrap; }
  .link-chip-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .link-chip-path {
    min-width: 0;
    /* Opaque paths (Google Drive ids) trail off instead of stretching the pill. */
    max-width: 24ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .link-chip-arrow { flex-shrink: 0; opacity: 0.6; }
  .link-chip:hover .link-chip-arrow { opacity: 1; }

  /* --- Lightbox --- */

  #lightbox {
    width: min(1200px, 92vw);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: none;
    border-radius: 12px;
    background: transparent;
    overflow: visible;
  }
  #lightbox::backdrop { background: rgba(0, 0, 0, 0.85); }

  #lightbox-stage img,
  #lightbox-stage video {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 88vh;
    margin-inline: auto;
    border-radius: 12px;
  }
  #lightbox-stage iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 12px;
  }

  #lightbox-caption {
    margin-top: var(--sp-1);
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  #lightbox-caption:empty { display: none; }

  #lightbox-close {
    position: fixed;
    top: var(--sp-2);
    right: var(--sp-2);
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg-elevated);
    color: var(--text);
    cursor: pointer;
  }
  #lightbox-close:hover { border-color: var(--accent); color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
