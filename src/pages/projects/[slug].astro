---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// Only an explicit cover is 16:9; a screenshot pulled from the text would be
// letterboxed by social cards, so those fall back to the site image.
---
<Base
  title={`${entry.data.title} — Варганов Арсений`}
  description={entry.data.summary}
  image={entry.data.cover}
>
  <main class="wrap">
    <a class="back" href="/">← Портфолио</a>

    <div id="project-body">
      <header class="project-head">
        <h1>{entry.data.title}</h1>
        <p class="period">{entry.data.period}</p>
      </header>

      <article class="content">
        <Content />
      </article>
    </div>
  </main>
</Base>

<style>
  /* A single article does not need the full grid width. */
  .wrap { max-width: 820px; }

  .back {
    display: inline-block;
    margin-bottom: var(--sp-3);
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .back:hover { color: var(--accent); }
</style>
