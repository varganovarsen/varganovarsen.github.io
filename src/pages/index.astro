---
import Base from "../layouts/Base.astro";
import { getCollection, getEntry, render } from "astro:content";

const entries = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

// A card shows the project's own cover, falling back to the first image in its text.
const projects = entries.map((entry) => ({
  entry,
  cover: entry.data.cover ?? entry.body?.match(/!\[[^\]]*\]\((\/[^)\s]+\.(?:png|jpe?g|webp|gif))\)/)?.[1],
}));

const intro = await getEntry("home", "intro");
const outro = await getEntry("home", "outro");
const { Content: Intro } = await render(intro!);
const { Content: Outro } = await render(outro!);

const description = intro!.body?.split("\n\n")[0]?.replace(/\s+/g, " ").trim().slice(0, 200);
---
<Base title={`${intro!.data.title} — Портфолио`} description={description}>
  <main class="wrap">
    <header class="hero">
      <h1>{intro!.data.title}</h1>
    </header>

    <div class="content home-content home-intro">
      <Intro />
    </div>

    <section>
      <h2>Проекты</h2>
      <div class="grid">
        {projects.map(({ entry, cover }) => (
          <a class="card" href={`/projects/${entry.id}/`} data-project={entry.id}>
            {cover ? (
              <img class="card-cover" src={cover} alt="" loading="lazy" />
            ) : (
              <span class="card-cover card-cover-empty" aria-hidden="true">{entry.data.period}</span>
            )}
            <span class="card-body">
              <span class="card-period">{entry.data.period}</span>
              <span class="card-title">{entry.data.title}</span>
              <span class="card-summary">{entry.data.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <div class="content home-content">
      <Outro />
    </div>
  </main>

  <dialog id="drawer" aria-label="Описание проекта">
    <button id="drawer-close" type="button" aria-label="Закрыть">✕</button>
    <div id="drawer-content"></div>
  </dialog>
</Base>

<script>
  const drawer = document.getElementById("drawer") as HTMLDialogElement;
  const content = document.getElementById("drawer-content")!;
  const homeTitle = document.title;
  const cache = new Map<string, string>();

  // Tracks whether the open drawer owns a history entry, so closing can go back
  // instead of stacking another one.
  let pushedEntry = false;

  async function loadProject(slug: string) {
    if (!cache.has(slug)) {
      const response = await fetch(`/projects/${slug}/`);
      if (!response.ok) throw new Error(`${response.status} for /projects/${slug}/`);
      const parsed = new DOMParser().parseFromString(await response.text(), "text/html");
      const body = parsed.getElementById("project-body");
      if (!body) throw new Error(`no #project-body in /projects/${slug}/`);
      cache.set(slug, body.innerHTML);
    }
    return cache.get(slug)!;
  }

  async function open(slug: string, push: boolean) {
    let html: string;
    try {
      html = await loadProject(slug);
    } catch {
      // Never leave a dead card: fall back to the standalone page.
      location.href = `/projects/${slug}/`;
      return;
    }

    content.innerHTML = html;
    document.dispatchEvent(new CustomEvent("drawer:content"));

    if (!drawer.open) drawer.showModal();
    lockScroll(true);
    // Let the dialog paint off-screen before transitioning it in.
    requestAnimationFrame(() => drawer.classList.add("open"));
    drawer.scrollTop = 0;

    const title = content.querySelector("h1, h2")?.textContent ?? "";
    document.title = `${title} — Варганов Арсений`;

    if (push) {
      history.pushState({ slug }, "", `/projects/${slug}/`);
      pushedEntry = true;
    }
  }

  function close(useHistory: boolean) {
    if (!drawer.open) return;

    if (useHistory && pushedEntry) {
      // popstate runs close(false), which does the actual dismissal.
      history.back();
      return;
    }

    drawer.classList.remove("open");
    document.title = homeTitle;
    pushedEntry = false;

    const finish = () => {
      if (!drawer.classList.contains("open")) {
        drawer.close();
        lockScroll(false);
      }
    };
    drawer.addEventListener("transitionend", finish, { once: true });
    // Fallback for when the transition is skipped (reduced motion, hidden tab).
    setTimeout(finish, 300);
  }

  // iOS ignores `overflow: hidden` on body, so pin the page instead.
  let savedScroll = 0;
  function lockScroll(on: boolean) {
    if (on) {
      // Opening another project from inside the drawer must not overwrite the
      // position we have to return to.
      if (document.body.style.position === "fixed") return;
      savedScroll = window.scrollY;
      document.body.style.cssText = `position:fixed;top:${-savedScroll}px;left:0;right:0;`;
    } else if (document.body.style.position === "fixed") {
      document.body.style.cssText = "";
      window.scrollTo(0, savedScroll);
    }
  }

  document.addEventListener("click", (event) => {
    const mouseEvent = event as MouseEvent;
    // Let modified clicks fall through so "open in new tab" keeps working.
    if (mouseEvent.metaKey || mouseEvent.ctrlKey || mouseEvent.shiftKey || mouseEvent.button !== 0) return;

    if (event.target === drawer || (event.target as HTMLElement).closest("#drawer-close")) {
      close(true);
      return;
    }

    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[href]");
    if (!link) return;

    const slug =
      link.dataset.project ??
      link.getAttribute("href")?.match(/^\/projects\/([^/]+)\/?$/)?.[1];
    if (!slug) return;

    event.preventDefault();
    open(slug, true);
  });

  // Escape fires `cancel`; take it over so the panel animates out.
  drawer.addEventListener("cancel", (event) => {
    event.preventDefault();
    close(true);
  });

  window.addEventListener("popstate", (event) => {
    const slug = (event.state as { slug?: string } | null)?.slug;
    // A restored project entry is a real history entry, so closing can still go back.
    pushedEntry = Boolean(slug);
    if (slug) open(slug, false);
    else close(false);
  });

  if (history.state?.slug) open(history.state.slug, false);
</script>

<style is:global>
  #drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(760px, 100%);
    max-width: none;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    border-left: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform 0.22s ease;
  }
  #drawer.open { transform: translateX(0); }

  #drawer::backdrop {
    background: rgba(0, 0, 0, 0);
    transition: background 0.22s ease;
  }
  #drawer.open::backdrop { background: rgba(0, 0, 0, 0.65); }

  #drawer-content {
    padding: var(--sp-6) var(--sp-4) var(--sp-8);
    max-width: 64ch;
  }

  #drawer-close {
    position: fixed;
    top: var(--sp-2);
    right: var(--sp-2);
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg-elevated);
    color: var(--text);
    cursor: pointer;
    z-index: 1;
  }
  #drawer-close:hover { border-color: var(--accent); color: var(--accent); }

  @media (max-width: 640px) {
    #drawer { border-left: none; }
    #drawer-content { padding: var(--sp-6) var(--sp-3) var(--sp-6); }
  }

  /* The home page is authored as markdown, so its blocks are styled here. */
  .home-intro > :first-child { margin-top: 0; }

  /* The pitch alone is set larger — scoped to the intro, or the first release
     line would be lifted with it. */
  .home-intro > p:first-of-type {
    font-size: var(--s1);
    line-height: 1.5;
  }

  .home-content h2 {
    font-size: var(--s2);
    border-bottom: 1px solid #3a4a42;
    padding-bottom: var(--sp-1);
    /* Sections need clear air above them: the gap belongs to the heading, not
       to the block it follows. */
    margin: var(--sp-8) 0 var(--sp-3);
  }

  /* One column: pitch, stack, contacts. Prose keeps its measure; the chips
     and the contact line run the full width. */
  .home-intro > * { max-width: 68ch; }
  .home-intro > .chips { max-width: none; }
  .home-intro > blockquote {
    max-width: none;
    margin: var(--sp-4) 0 0;
    text-align: center;
  }

  /* --- Chips (the stack line) --- */

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: var(--sp-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    position: relative;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--text-dim);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  /* A chip with more to say marks itself and shows the rest on hover or focus. */
  .chips li[data-tip] {
    cursor: help;
    border-color: var(--border-strong);
    color: var(--text);
  }
  .chips li[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    width: max-content;
    max-width: min(280px, 70vw);
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg-sunken);
    color: var(--text);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: left;
    white-space: normal;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease;
    pointer-events: none;
  }
  .chips li[data-tip]:hover::after,
  .chips li[data-tip]:focus-visible::after {
    opacity: 1;
    visibility: visible;
  }

  .home-content .steam-embeds { margin: var(--sp-3) 0; }

  /* Contacts read as a line, like the one in the footer — no panel. */
  .home-content blockquote {
    margin: var(--sp-3) 0;
    padding: 0;
    border: none;
    color: var(--text-dim);
  }
  .home-content blockquote p { margin: 0; }

  .home-content hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--sp-6) 0 var(--sp-3);
  }
</style>

<style>
  .hero { margin-bottom: var(--sp-4); }
  .hero h1 { font-size: var(--s4); margin: 0; }

  section { margin-top: var(--sp-6); }
  section h2 {
    font-size: var(--s2);
    border-bottom: 1px solid #3a4a42;
    padding-bottom: var(--sp-1);
    margin-bottom: var(--sp-3);
  }

  .grid {
    display: grid;
    /* 260 keeps three cards per row inside the 920px page: 3 x 260 plus two
       gaps fits the 872px of content width. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--sp-3);
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .card-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-sunken);
  }

  /* Projects without artwork get a deliberate typographic plate, not a grey box. */
  .card-cover-empty {
    display: grid;
    place-items: center;
    font-size: var(--s4);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #2b303b;
    background: linear-gradient(140deg, #191c24, #0f1116);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-2);
  }

  .card-period { color: var(--accent); opacity: 0.75; font-size: 0.875rem; }
  .card-title { font-size: 1.125rem; font-weight: 600; line-height: 1.25; }
  .card-summary { color: var(--text-dim); font-size: 0.9375rem; line-height: 1.45; }
</style>
